# ============================================================
# SUPABASE (required)
# Get these from: https://app.supabase.com → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# IA — choose one or both
# ============================================================

# Option A: n8n Webhook URL (preferred)
# Create a webhook trigger in your n8n flow and paste the URL here.
# The flow receives: { product, offer, platform }
# The flow must return: { adText: "..." }
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/generate-ad

# Option B: OpenAI Direct (fallback when N8N_WEBHOOK_URL is not set)
OPENAI_API_KEY=sk-...

# ============================================================
# STRIPE (optional — for paid plans)
# ============================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
